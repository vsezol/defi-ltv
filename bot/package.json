{
  "name": "defi-ltv-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram UI microservice for defi-ltv: renders menus/messages, proxies commands to the core API, receives push notifications on /notify",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
