# ===== Core service (monolith: DB + scanners + alert loops + REST API + webapp) =====

# Telegram bot token from @BotFather (required — used here only to validate
# webapp auth: Mini App initData and Login Widget signatures).
BOT_TOKEN=

# PostgreSQL connection string (required). For local dev with docker-compose:
#   docker compose up -d
DATABASE_URL=postgres://postgres:dev@localhost:5432/postgres

# Shared secret between the core service and the bot microservice (required).
# Generate one: openssl rand -hex 32 — must be identical in both services.
INTERNAL_TOKEN=dev-internal-token

# Base URL of the bot microservice (required for alert delivery). Local dev:
# http://localhost:3100. Railway private networking: http://<bot-service>.railway.internal:3100
BOT_URL=http://localhost:3100

# HTTP port for the API + webapp (optional, default 3000). Railway injects PORT.
PORT=3000

# Redis URL for the ephemeral cache (markets). Optional — falls back to
# an in-memory cache. Set this (and install @keyv/redis) to use Redis.
REDIS_URL=

# Logging mode: set to "production" for plain JSON logs.
# Anything else (or empty) enables pretty dev logs. (optional)
NODE_ENV=development

# Solana RPC URL(s) for Orca position scanning (optional, comma-separated).
# Many public RPCs now block getTokenAccountsByOwner; set a private endpoint
# (e.g. a free Helius/QuickNode key) for reliable Orca monitoring.
# Falls back to keyless public RPCs if unset.
SOLANA_RPC_URL=

# ===== Bot microservice (bot/) uses its own env — see bot/.env.example =====
# BOT_TOKEN, CORE_URL, INTERNAL_TOKEN, PORT, WEBAPP_URL
