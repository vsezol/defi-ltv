# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# PostgreSQL connection string (required). For local dev with docker-compose:
#   docker compose up -d
DATABASE_URL=postgres://postgres:dev@localhost:5432/postgres

# Redis URL for the ephemeral cache (markets + UI state). Optional — falls back
# to an in-memory cache. Set this (and install @keyv/redis) to use Redis.
REDIS_URL=

# Logging mode: set to "production" for plain JSON logs.
# Anything else (or empty) enables pretty dev logs. (optional)
NODE_ENV=development

# Solana RPC URL(s) for Orca position scanning (optional, comma-separated).
# Many public RPCs now block getTokenAccountsByOwner; set a private endpoint
# (e.g. a free Helius/QuickNode key) for reliable Orca monitoring.
# Falls back to keyless public RPCs if unset.
SOLANA_RPC_URL=

# Public HTTPS URL of the Telegram Mini App (optional). When set, the bot's
# menu button opens the app. On Railway: Settings -> Networking -> Generate
# Domain, then put that URL here (https://<app>.up.railway.app).
WEBAPP_URL=

# HTTP port for the Mini App server (optional, default 3000). Railway sets PORT.
PORT=3000
